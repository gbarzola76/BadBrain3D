    "@fontsource/rubik-mono-one": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=18"
